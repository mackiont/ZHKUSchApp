<?xml version="1.0" encoding="utf-8"?>
<!--
  2×2 正方形（约 110dp），只排 4 行，字号都刻意压小：
  状态 → 课程名（最多两行）→ 时间+地点 → 倒计时。
  行与行之间用 LinearLayout 顺排，不用 RelativeLayout 叠放，避免长课程名把倒计时压穿。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="11dp">

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/widget_status_placeholder"
        android:textColor="@color/widget_accent"
        android:textSize="9sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_course"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:autoSizeMaxTextSize="14sp"
        android:autoSizeMinTextSize="9sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="@string/widget_course_placeholder"
        android:textColor="@color/widget_text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/widget_meta_placeholder"
        android:textColor="@color/widget_text_secondary"
        android:textSize="9sp" />

    <Chronometer
        android:id="@+id/widget_countdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:textColor="@color/widget_accent"
        android:textSize="11sp"
        android:textStyle="bold" />

</LinearLayout>
